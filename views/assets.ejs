<p class="muted" style="margin-top:-8px;">Evidencia majetku spoločnosti.</p>

<div class="grid cards">
  <% items.forEach(function(it){ %>
    <a class="card" href="<%= it.href %>" style="text-decoration:none; color:inherit;">
      <div class="app-ico"><%- icon(it.icon, 24) %></div>
      <h2 style="margin:10px 0 6px;"><%= it.label %><% if (typeof it.count !== 'undefined') { %> <span class="muted" style="font-weight:normal;">(<%= it.count %>)</span><% } %></h2>
      <p class="muted" style="font-size:.9rem; margin:0;"><%= it.desc %></p>
    </a>
  <% }) %>
</div>
