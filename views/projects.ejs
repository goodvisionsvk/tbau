<% if (canManage) { %>
<div style="display:flex; justify-content:flex-end;">
  <a class="btn btn-primary" href="/projects/novy"><%- icon('plus', 16) %> Pridať novú stavbu</a>
</div>
<% } %>

<div class="card">
  <form method="get" action="/projects" class="form-row" style="align-items:end; margin:0;">
    <div class="field" style="margin-bottom:0;"><label>Hľadať</label><input name="q" value="<%= filter.q %>" placeholder="Názov, kód, klient, miesto"></div>
    <div class="field" style="margin-bottom:0;"><label>Stav</label>
      <select name="status"><option value="">Všetky</option>
        <% Object.keys(statuses).forEach(function(k){ %><option value="<%= k %>" <%= filter.status===k?'selected':'' %>><%= statuses[k] %></option><% }) %>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;"><button class="btn btn-ghost">Filtrovať</button></div>
  </form>
</div>

<div class="section">
  <% if (!projects.length) { %>
    <div class="card muted">Žiadne stavby pre zvolený filter.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Stavba</th><th>Klient</th><th>Miesto</th><th>KW</th><th>Stav</th><th></th></tr></thead>
        <tbody>
          <% projects.forEach(function(p){ %>
            <tr>
              <td><a href="/projects/<%= p.id %>"><b><%= p.name %></b></a><% if (p.code){ %><br><span class="muted" style="font-size:.8rem;"><%= p.code %></span><% } %></td>
              <td class="muted"><%= p.client || '—' %></td>
              <td class="muted"><%= p.address || '—' %></td>
              <td class="muted"><%= (p.kw_od || p.kw_do) ? ((p.kw_od||'?') + '–' + (p.kw_do||'?')) : '—' %></td>
              <td><span class="pill <%= p.status %>"><%= statuses[p.status] || p.status %></span></td>
              <td class="actions">
                <a class="btn btn-ghost btn-sm" href="/projects/<%= p.id %>">Detail</a>
                <% if (canManage) { %>
                  <form class="inline" method="post" action="/projects/<%= p.id %>/delete" onsubmit="return confirm('Zmazať stavbu? Zmažú sa aj priradenia a dochádzka.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm">Zmazať</button></form>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
