<div class="grid stats">
  <% cards.forEach(function(c){ %>
    <a class="card stat" href="<%= c.href %>" style="text-decoration:none; color:inherit;">
      <span class="ico"><%= c.icon %></span>
      <span class="num"><%= c.num %></span>
      <span class="lbl"><%= c.label %></span>
    </a>
  <% }) %>
</div>

<% if (full && recentRequests && recentRequests.length) { %>
<div class="section">
  <h2>Nové žiadosti o zmenu</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Zamestnanec</th><th>Dátum</th><th>Správa</th><th></th></tr></thead>
      <tbody>
        <% recentRequests.forEach(function(r){ %>
          <tr>
            <td><%= r.last_name %> <%= r.first_name %></td>
            <td class="muted"><%= r.work_date || '—' %></td>
            <td class="muted"><%= (r.message || '').slice(0,80) %></td>
            <td><a class="btn btn-ghost btn-sm" href="/ziadosti">Riešiť</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>
