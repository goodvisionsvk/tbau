<div class="grid stats">
  <% cards.forEach(function(c){ %>
    <a class="card stat" href="<%= c.href %>" style="text-decoration:none; color:inherit;">
      <span class="ico"><%= c.icon %></span>
      <span class="num"><%= c.num %></span>
      <span class="lbl"><%= c.label %></span>
    </a>
  <% }) %>
</div>

<% if (apps && apps.length) { %>
<div class="section">
  <h2>Aplikácie</h2>
  <div class="grid cards">
    <% apps.forEach(function(a){ %>
      <% if (a.href) { %><a class="card" href="<%= a.href %>" style="text-decoration:none; color:inherit;"><% } else { %><div class="card"><% } %>
        <div style="font-size:1.6rem;"><%= a.icon %></div>
        <h2 style="margin:8px 0 6px; font-size:1.05rem;"><%= a.name %></h2>
        <p class="muted" style="font-size:.86rem; margin:0 0 12px;"><%= a.description %></p>
        <span class="pill <%= a.status %>">
          <%= a.status === 'planned' ? 'plánované' : (a.status === 'in_progress' ? 'vo vývoji' : 'aktívne') %>
        </span>
      <% if (a.href) { %></a><% } else { %></div><% } %>
    <% }) %>
  </div>
</div>
<% } %>

<% if (full && recentRequests && recentRequests.length) { %>
<div class="section">
  <h2>Nové žiadosti o zmenu</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Zamestnanec</th><th>Dátum</th><th>Správa</th><th></th></tr></thead>
      <tbody>
        <% recentRequests.forEach(function(r){ %>
          <tr>
            <td><%= r.last_name %> <%= r.first_name %></td>
            <td class="muted"><%= r.work_date || '—' %></td>
            <td class="muted"><%= (r.message || '').slice(0,80) %></td>
            <td><a class="btn btn-ghost btn-sm" href="/ziadosti">Riešiť</a></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>
