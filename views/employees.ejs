<div style="display:flex; justify-content:flex-end;">
  <a class="btn btn-primary" href="/zamestnanci/novy"><%- icon('plus', 16) %> Pridať nového zamestnanca</a>
</div>

<div class="card">
  <form method="get" action="/zamestnanci" class="form-row" style="align-items:end; margin:0;">
    <div class="field" style="margin-bottom:0;"><label>Hľadať</label><input name="q" value="<%= filter.q %>" placeholder="Meno, priezvisko, os. číslo"></div>
    <div class="field" style="margin-bottom:0;"><label>Stavba</label>
      <select name="stavba"><option value="">Všetky</option>
        <% projects.forEach(function(p){ %><option value="<%= p.id %>" <%= String(filter.stavba)===String(p.id)?'selected':'' %>><%= p.name %></option><% }) %>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;"><label>Pozícia</label>
      <select name="position"><option value="">Všetky</option>
        <% Object.keys(positions).forEach(function(k){ %><option value="<%= k %>" <%= filter.position===k?'selected':'' %>><%= positions[k] %></option><% }) %>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;"><label>Druh robotníka</label>
      <select name="trade"><option value="">Všetky</option>
        <% trades.forEach(function(t){ %><option value="<%= t %>" <%= filter.trade===t?'selected':'' %>><%= t %></option><% }) %>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;">
      <label style="display:flex; gap:6px; align-items:center;"><input type="checkbox" name="archived" value="1" style="width:auto;" <%= filter.archived?'checked':'' %>> Archivovaní</label>
    </div>
    <div class="field" style="margin-bottom:0;"><button class="btn btn-ghost">Filtrovať</button></div>
  </form>
</div>

<div class="section">
  <% if (!employees.length) { %>
    <div class="card muted">Žiadni zamestnanci pre zvolený filter.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Priezvisko a meno</th><th>Pozícia</th><th>Druh robotníka</th><th>Stavba</th><th>Os. číslo</th><th>Telefón</th><th>Prihlásenie</th><th></th></tr></thead>
        <tbody>
          <% employees.forEach(function(e){ %>
            <tr>
              <td><a href="/zamestnanci/<%= e.id %>"><b><%= e.last_name %> <%= e.first_name %></b></a></td>
              <td class="muted"><%= e.position ? positions[e.position] : '—' %></td>
              <td class="muted"><%= e.position==='robotnik' ? (e.trade || '—') : '—' %></td>
              <td class="muted"><%= e.sites || '—' %></td>
              <td class="muted"><%= e.employee_number || '—' %></td>
              <td class="muted"><%= e.phone || '—' %></td>
              <td class="muted"><%= e.login_email || '—' %></td>
              <td class="actions">
                <a class="btn btn-ghost btn-sm" href="/zamestnanci/<%= e.id %>">Upraviť</a>
                <form class="inline" method="post" action="/zamestnanci/<%= e.id %>/archive"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm"><%= filter.archived ? 'Obnoviť' : 'Archivovať' %></button></form>
                <form class="inline" method="post" action="/zamestnanci/<%= e.id %>/delete" onsubmit="return confirm('Úplne zmazať <%= e.last_name %> <%= e.first_name %>? Zmaže sa aj jeho dochádzka a priradenia.')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm">Zmazať</button></form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
