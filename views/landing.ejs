<div class="public-wrap">
  <div class="landing">
    <img class="logo" src="/static/img/logo.png" alt="<%= company.name %>">
    <div class="tag" style="margin-top:22px;">FIREMNÝ PORTÁL</div>
    <h1><%= company.name %></h1>
    <p class="desc"><%= company.description %></p>
    <a class="btn btn-primary cta" href="/login">Prihlásiť sa &rarr;</a>

    <div class="company-facts">
      <span><b>Sídlo:</b> <%= company.address %></span>
      <span><b>IČO:</b> <%= company.ico %></span>
      <span><b>DIČ:</b> <%= company.dic %></span>
      <span><b>E-mail:</b> <%= company.email %></span>
      <span><b>Tel.:</b> <%= company.phone %></span>
    </div>
  </div>
</div>
