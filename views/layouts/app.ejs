<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= company.shortName %> portál</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/css/style.css">
  <link rel="icon" type="image/png" href="/static/img/logo.png">
</head>
<body class="app">
  <header class="topbar">
    <a class="brand" href="/dashboard"><img class="brand-logo" src="/static/img/logo.png" alt="TBAU"></a>
    <div class="topbar-right">
      <% if (currentUser) { %>
        <span class="user-chip">
          <%= currentUser.full_name || currentUser.email %>
          <% if (currentUser.role === 'admin') { %><span class="badge">admin</span><% } %>
        </span>
        <a class="btn-link" href="/account/password">Zmena hesla</a>
        <form class="inline" method="post" action="/logout">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn btn-ghost btn-sm">Odhlásiť</button>
        </form>
      <% } else { %>
        <a class="btn btn-primary btn-sm" href="/login">Prihlásiť sa</a>
      <% } %>
    </div>
  </header>
  <div class="shell">
    <% if (currentUser) { %>
    <aside class="sidebar">
      <nav>
        <% nav.forEach(function(item){
             if (item.adminOnly && currentUser.role !== 'admin') return; %>
          <a class="nav-item <%= active === item.key ? 'active' : '' %>" href="<%= item.href %>">
            <span class="nav-ico"><%= item.icon %></span><%= item.label %>
          </a>
        <% }) %>
      </nav>
      <div class="sidebar-foot"><%= company.name %><br>IČO <%= company.ico %></div>
    </aside>
    <% } %>
    <main class="content">
      <div class="page-head"><h1><%= title %></h1></div>
      <%- body %>
    </main>
  </div>
</body>
</html>
