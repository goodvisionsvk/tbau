<!DOCTYPE html>
<html lang="sk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · <%= company.shortName %> portál</title>
  <link rel="stylesheet" href="/static/css/style.css">
  <link rel="icon" type="image/png" href="/static/img/logo.png">
</head>
<body class="app">
  <header class="topbar">
    <div class="topbar-left">
      <% if (currentUser) { %>
        <button class="nav-toggle" type="button" aria-label="Otvoriť menu" aria-expanded="false">☰</button>
      <% } %>
      <a class="brand" href="<%= currentUser ? '/dashboard' : '/' %>"><img class="brand-logo" src="/static/img/logo.png" alt="TBAU"></a>
    </div>
    <div class="topbar-right">
      <% if (currentUser) { %>
        <% var isFull = ['sef','admin'].indexOf(currentUser.role) >= 0; %>
        <div class="profile" id="profile">
          <button class="profile-btn" type="button" aria-haspopup="true" aria-expanded="false">
            <span class="profile-name"><%= currentUser.full_name || currentUser.email %></span>
            <% if (isFull) { %><span class="badge"><%= currentUser.role === 'sef' ? 'šéf' : 'admin' %></span><% } %>
            <span class="profile-caret"><%- icon('chevron', 16) %></span>
          </button>
          <div class="profile-menu" hidden>
            <% if (isFull) { %><a class="profile-item" href="/nastavenia"><%- icon('settings', 16) %> Nastavenia</a><% } %>
            <a class="profile-item" href="/account/password"><%- icon('key', 16) %> Zmena hesla</a>
            <form method="post" action="/logout">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="profile-item" type="submit"><%- icon('logout', 16) %> Odhlásiť</button>
            </form>
          </div>
        </div>
      <% } else { %>
        <a class="btn btn-primary btn-sm" href="/login">Prihlásiť sa</a>
      <% } %>
    </div>
  </header>
  <div class="shell">
    <% if (currentUser) { %>
    <aside class="sidebar" id="sidebar">
      <nav>
        <% nav.forEach(function(group){ %>
          <% if (group.label) { %>
            <% var grpOpen = group.items.some(function(it){ return it.key === active; }); %>
            <div class="nav-grp<%= grpOpen ? ' open' : '' %>" data-grp="<%= group.label %>">
              <button type="button" class="nav-group" aria-expanded="<%= grpOpen ? 'true' : 'false' %>">
                <% if (group.icon) { %><span class="nav-grp-ico"><%- icon(group.icon, 16) %></span><% } %>
                <span><%= group.label %></span>
              </button>
              <div class="nav-group-items">
                <% group.items.forEach(function(item){ %>
                  <a class="nav-item <%= active === item.key ? 'active' : '' %>" href="<%= item.href %>">
                    <span class="nav-ico"><%- icon(item.icon) %></span><%= item.label %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } else { %>
            <div class="nav-grp open">
              <div class="nav-group-items">
                <% group.items.forEach(function(item){ %>
                  <a class="nav-item <%= active === item.key ? 'active' : '' %>" href="<%= item.href %>">
                    <span class="nav-ico"><%- icon(item.icon) %></span><%= item.label %>
                  </a>
                <% }) %>
              </div>
            </div>
          <% } %>
        <% }) %>
      </nav>
      <div class="sidebar-foot"><%= company.name %><br>IČO <%= company.ico %></div>
    </aside>
    <div class="nav-backdrop" hidden></div>
    <% } %>
    <main class="content">
      <div class="page-head"><h1><%= title %></h1></div>
      <%- body %>
    </main>
  </div>
  <% if (currentUser) { %><script src="/static/js/app.js" defer></script><% } %>
</body>
</html>
