<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (typeof saved !== 'undefined' && saved) { %><div class="alert alert-info">Dochádzka bola uložená.</div><% } %>

<!-- prepínač pohľadu -->
<div class="actions" style="margin-bottom:14px;">
  <a class="btn btn-sm <%= view==='week' ? 'btn-primary' : 'btn-ghost' %>"
     href="/dochadzka?view=week&project=<%= project ? project.id : '' %>&year=<%= year %>">Týždeň</a>
  <a class="btn btn-sm <%= view==='month' ? 'btn-primary' : 'btn-ghost' %>"
     href="/dochadzka?view=month&project=<%= project ? project.id : '' %>&year=<%= year %>">Mesiac</a>
</div>

<div class="card">
  <form method="get" action="/dochadzka" class="form-row" style="align-items:end; margin:0;">
    <input type="hidden" name="view" value="<%= view %>">
    <div class="field" style="margin-bottom:0;">
      <label>Stavba</label>
      <select name="project" onchange="this.form.submit()">
        <% if (!projects.length) { %><option>— žiadna stavba —</option><% } %>
        <% projects.forEach(function(p){ %>
          <option value="<%= p.id %>" <%= project && project.id===p.id ? 'selected':'' %>><%= p.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;"><label>Rok</label><input type="number" name="year" value="<%= year %>" style="max-width:110px;"></div>
    <% if (view === 'week') { %>
      <div class="field" style="margin-bottom:0;"><label>Týždeň (ISO)</label><input type="number" name="week" min="1" max="53" value="<%= week %>" style="max-width:110px;"></div>
    <% } else { %>
      <div class="field" style="margin-bottom:0;"><label>Mesiac</label>
        <select name="month"><% for (var mm=1;mm<=12;mm++){ %><option value="<%= mm %>" <%= month===mm?'selected':'' %>><%= mm %></option><% } %></select>
      </div>
    <% } %>
    <div class="field" style="margin-bottom:0;"><button class="btn btn-ghost">Zobraziť</button></div>
  </form>
</div>

<% if (!project) { %>
  <div class="card muted" style="margin-top:20px;">Nemáš priradenú žiadnu stavbu. Stavby a priradenie ľudí spravuje administratíva.</div>

<% } else if (view === 'week') { %>
<!-- ======================= TÝŽDŇOVÝ (editovateľný) ======================= -->
<div class="section">
  <h2><%= project.name %> — týždeň <%= week %>/<%= year %> (<%= days[0].date %> – <%= days[6].date %>)</h2>

  <% if (!rows.length) { %>
    <div class="card muted">Na tejto stavbe nie sú priradení žiadni zamestnanci. Priraď ich v <a href="/projects/<%= project.id %>">detaile stavby</a>.</div>
  <% } else { %>
  <form method="post" action="/dochadzka/save">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="project" value="<%= project.id %>">
    <input type="hidden" name="year" value="<%= year %>">
    <input type="hidden" name="week" value="<%= week %>">
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Zamestnanec</th>
            <% days.forEach(function(d){ %>
              <th style="text-align:center; <%= d.weekend ? 'color:#b00;' : '' %>"><%= d.label %><br><span class="muted" style="font-weight:400;"><%= d.day %>.<%= d.month %>.</span></th>
            <% }) %>
            <th style="text-align:center;">Spolu</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r){ %>
            <tr>
              <td><b><%= r.employee.last_name %> <%= r.employee.first_name %></b><% if (r.employee.employee_number){ %><br><span class="muted" style="font-size:.78rem;"><%= r.employee.employee_number %></span><% } %></td>
              <% days.forEach(function(d){ %>
                <td style="text-align:center; <%= d.weekend ? 'background:#fafafa;' : '' %>">
                  <input type="number" step="0.5" min="0" max="24"
                    name="h_<%= r.employee.id %>_<%= d.date %>"
                    value="<%= r.hours[d.date] != null ? r.hours[d.date] : '' %>"
                    style="width:58px; text-align:center; padding:6px;">
                </td>
              <% }) %>
              <td style="text-align:center;"><b><%= r.total %></b></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <div style="margin-top:16px;"><button class="btn btn-primary">💾 Uložiť dochádzku</button></div>
  </form>
  <% } %>
</div>

<div class="section">
  <h2>Smenovky za tento týždeň</h2>
  <div class="card">
    <form method="post" action="/dochadzka/smenovka" enctype="multipart/form-data" class="form-row" style="align-items:end;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="project" value="<%= project.id %>">
      <input type="hidden" name="year" value="<%= year %>">
      <input type="hidden" name="week" value="<%= week %>">
      <div class="field" style="margin-bottom:0;"><label>Súbor smenovky (JPG, PNG, PDF)</label><input type="file" name="file" accept="image/jpeg,image/png,application/pdf" required></div>
      <div class="field" style="margin-bottom:0;"><label>Poznámka</label><input name="note"></div>
      <div class="field" style="margin-bottom:0;"><button class="btn btn-dark">Nahrať</button></div>
    </form>
  </div>

  <% if (sheets && sheets.length) { %>
    <div class="table-wrap" style="margin-top:14px;">
      <table>
        <thead><tr><th>Dokument</th><th>Nahraté</th><th>Poznámka</th><th></th></tr></thead>
        <tbody>
          <% sheets.forEach(function(s){ %>
            <tr>
              <td>📄 <a href="/dochadzka/smenovka/<%= s.id %>/subor" target="_blank"><%= s.original_name || 'smenovka' %></a></td>
              <td class="muted"><%= s.uploaded_at %></td>
              <td class="muted"><%= s.note || '—' %></td>
              <td>
                <form class="inline" method="post" action="/dochadzka/smenovka/<%= s.id %>/delete" onsubmit="return confirm('Zmazať smenovku?')">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button class="btn btn-danger btn-sm">Zmazať</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } else { %>
    <p class="muted" style="margin-top:12px;">Za tento týždeň zatiaľ nie je nahratá žiadna smenovka.</p>
  <% } %>
</div>

<% } else { %>
<!-- ======================= MESAČNÝ (prehľad) ======================= -->
<div class="section">
  <div class="page-head" style="margin-bottom:12px;">
    <h2 style="margin:0;"><%= project.name %> — <%= monthName %> <%= year %></h2>
    <a class="btn-link" href="/dochadzka?view=week&project=<%= project.id %>&year=<%= year %>">Upraviť po týždňoch &rarr;</a>
  </div>
  <% if (!rows.length) { %>
    <div class="card muted">Na tejto stavbe nie sú priradení žiadni zamestnanci.</div>
  <% } else { %>
    <div class="table-wrap">
      <table style="font-size:.82rem;">
        <thead>
          <tr>
            <th style="position:sticky; left:0; background:#f7f8fa;">Zamestnanec</th>
            <% days.forEach(function(d){ %>
              <th style="text-align:center; padding:8px 6px; <%= d.weekend ? 'color:#b00;' : '' %>"><%= d.day %><br><span class="muted" style="font-weight:400; font-size:.68rem;"><%= d.label %></span></th>
            <% }) %>
            <th style="text-align:center;">Spolu</th>
          </tr>
        </thead>
        <tbody>
          <% rows.forEach(function(r){ %>
            <tr>
              <td style="position:sticky; left:0; background:#fff;"><b><%= r.employee.last_name %> <%= r.employee.first_name %></b></td>
              <% days.forEach(function(d){ %>
                <td style="text-align:center; padding:8px 6px; <%= d.weekend ? 'background:#fafafa;' : '' %>"><%= r.hours[d.date] != null ? r.hours[d.date] : '' %></td>
              <% }) %>
              <td style="text-align:center;"><b><%= r.total %></b></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot>
          <tr><th style="position:sticky; left:0; background:#f7f8fa;">Spolu stavba</th><th colspan="<%= days.length %>"></th><th style="text-align:center;"><%= grand %> h</th></tr>
        </tfoot>
      </table>
    </div>
    <p class="muted" style="margin-top:10px;">Mesačný export pre mzdy nájdeš v sekcii <a href="/reporty?year=<%= year %>&month=<%= month %>">Reporty</a>.</p>
  <% } %>
</div>
<% } %>
