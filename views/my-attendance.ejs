<% if (!employee) { %>
  <div class="card">
    <h2 style="margin-top:0;">Zatiaľ bez prepojenia</h2>
    <p class="muted">Tvoje konto ešte nie je prepojené so zamestnaneckým záznamom. Kontaktuj administratívu.</p>
  </div>
<% } else { %>

<% if (sent) { %><div class="alert alert-info">Žiadosť o zmenu bola odoslaná parťákovi/administratíve.</div><% } %>

<div class="grid stats">
  <div class="card stat"><span class="ico">🕒</span><span class="num"><%= month.total %></span><span class="lbl">Hodiny — <%= month.name %> <%= month.year %></span></div>
  <div class="card stat"><span class="ico">📅</span><span class="num"><%= month.rows.length %></span><span class="lbl">Odpracované dni</span></div>
</div>

<div class="card" style="margin-top:18px;">
  <form method="get" action="/moja-dochadzka" class="form-row" style="align-items:end; margin:0;">
    <div class="field" style="margin-bottom:0;"><label>Rok</label><input type="number" name="year" value="<%= month.year %>" style="max-width:120px;"></div>
    <div class="field" style="margin-bottom:0;"><label>Mesiac</label>
      <select name="month">
        <% for (var m=1;m<=12;m++){ %><option value="<%= m %>" <%= month.month===m?'selected':'' %>><%= m %></option><% } %>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;"><button class="btn btn-ghost">Zobraziť</button></div>
  </form>
</div>

<div class="section">
  <h2>Dochádzka — <%= month.name %> <%= month.year %></h2>
  <% if (!month.rows.length) { %>
    <div class="card muted">Za tento mesiac zatiaľ nie sú zapísané žiadne hodiny.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Dátum</th><th>Stavba</th><th style="text-align:right;">Hodiny</th></tr></thead>
        <tbody>
          <% month.rows.forEach(function(r){ %>
            <tr><td><%= r.work_date %></td><td class="muted"><%= r.project_name %></td><td style="text-align:right;"><b><%= r.hours %></b></td></tr>
          <% }) %>
        </tbody>
        <tfoot><tr><th colspan="2">Spolu</th><th style="text-align:right;"><%= month.total %> h</th></tr></tfoot>
      </table>
    </div>
  <% } %>
</div>

<div class="section">
  <h2>Žiadosť o zmenu dochádzky</h2>
  <div class="card">
    <p class="muted" style="margin-top:0;">Ak niečo v dochádzke nesedí, pošli žiadosť — pôjde parťákovi / administratíve.</p>
    <form method="post" action="/moja-dochadzka/ziadost">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row">
        <div class="field"><label>Dátum (voliteľné)</label><input type="date" name="work_date"></div>
        <div class="field"><label>Stavba (voliteľné)</label>
          <select name="project_id"><option value="">—</option>
            <% projects.forEach(function(p){ %><option value="<%= p.id %>"><%= p.name %></option><% }) %>
          </select>
        </div>
        <div class="field"><label>Správne hodiny (voliteľné)</label><input name="requested_hours" inputmode="decimal"></div>
      </div>
      <div class="field"><label>Správa *</label><textarea name="message" rows="3" required placeholder="Opíš, čo treba zmeniť…"></textarea></div>
      <button class="btn btn-primary">Odoslať žiadosť</button>
    </form>
  </div>
</div>

<div class="section">
  <h2>Moje žiadosti</h2>
  <% if (!requests.length) { %>
    <div class="card muted">Zatiaľ žiadne žiadosti.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Dátum podania</th><th>Dátum/hodiny</th><th>Správa</th><th>Stav</th><th>Odpoveď</th></tr></thead>
        <tbody>
          <% requests.forEach(function(r){ %>
            <tr>
              <td class="muted"><%= r.created_at %></td>
              <td class="muted"><%= r.work_date || '—' %><%= r.requested_hours != null ? ' / ' + r.requested_hours + ' h' : '' %></td>
              <td><%= r.message %></td>
              <td><span class="pill <%= r.status==='approved'?'done':(r.status==='rejected'?'high':'todo') %>"><%= r.status==='approved'?'schválené':(r.status==='rejected'?'zamietnuté':'otvorené') %></span></td>
              <td class="muted"><%= r.response || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>

<% } %>
