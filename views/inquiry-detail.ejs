<div style="display:flex; justify-content:space-between; align-items:center; margin-top:-8px; gap:12px; flex-wrap:wrap;">
  <a class="btn-link" href="/dopyty">&larr; Späť na dopyty</a>
  <div class="actions">
    <form class="inline" method="post" action="/dopyty/<%= inquiry.id %>/status">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <select name="status" onchange="this.form.submit()">
        <% Object.keys(statuses).forEach(function(k){ %><option value="<%= k %>" <%= inquiry.status===k?'selected':'' %>><%= statuses[k] %></option><% }) %>
      </select>
    </form>
    <form class="inline" method="post" action="/dopyty/<%= inquiry.id %>/delete" onsubmit="return confirm('Zmazať dopyt?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-danger btn-sm">Zmazať</button></form>
  </div>
</div>

<div class="grid" style="grid-template-columns:1fr; gap:24px;">
  <div class="card">
    <h2 style="margin-top:0;"><%= inquiry.title || ('Dopyt #' + inquiry.id) %></h2>
    <div class="grid" style="grid-template-columns:repeat(auto-fit,minmax(180px,1fr)); gap:12px 22px; margin-top:6px;">
      <div><div class="muted" style="font-size:13px;font-weight:600;">Zákazník</div><div><% if (customer) { %><a href="/zakaznici/<%= customer.id %>"><%= customer.name %></a><% } else { %>—<% } %></div></div>
      <div><div class="muted" style="font-size:13px;font-weight:600;">Profesia</div><div><%= inquiry.profession || '—' %></div></div>
      <div><div class="muted" style="font-size:13px;font-weight:600;">Voľní od</div><div><%= inquiry.free_from || '—' %></div></div>
      <div><div class="muted" style="font-size:13px;font-weight:600;">Cena</div><div><%= inquiry.price || '—' %></div></div>
    </div>
    <% if (emps.length) { %>
      <div style="margin-top:14px;"><div class="muted" style="font-size:13px;font-weight:600;">Ponúkaní pracovníci (<%= emps.length %>)</div>
        <div class="list" style="margin-top:4px;">
          <% emps.forEach(function(e){ %><div style="padding:4px 0;"><%= e.last_name %> <%= e.first_name %><% if (e.trade){ %> <span class="muted">– <%= e.trade %></span><% } %></div><% }) %>
        </div>
      </div>
    <% } %>
  </div>

  <div class="card">
    <h2 style="margin-top:0;">Referenčné stavby (prílohy)</h2>
    <% if (attachCount) { %><p class="muted" style="margin-top:0;">K e-mailu sa priloží <b><%= attachCount %></b> fotiek z vybraných referencií.</p><% } %>
    <% if (!allRefs.length) { %>
      <p class="muted">Žiadne referenčné stavby. Pridáš ich v sekcii <a href="/referencie">Referenčné stavby</a>.</p>
    <% } else { %>
      <form method="post" action="/dopyty/<%= inquiry.id %>/references">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <% allRefs.forEach(function(r){ %>
          <label style="display:flex; gap:10px; align-items:flex-start; padding:6px 0; border-bottom:1px solid var(--line-soft);">
            <input type="checkbox" name="reference_id" value="<%= r.id %>" style="width:auto; margin-top:3px;" <%= selectedRefIds.indexOf(r.id)>=0 ? 'checked' : '' %>>
            <span><b><%= r.title %></b><% if (r.location){ %> <span class="muted">· <%= r.location %></span><% } %> <span class="muted" style="font-size:.85rem;">· <%= r.img_count %> fotiek</span></span>
          </label>
        <% }) %>
        <button class="btn btn-dark btn-sm" style="margin-top:10px;">Uložiť výber referencií</button>
      </form>
    <% } %>
  </div>

  <div class="card">
    <h2 style="margin-top:0;">E-mail pre zákazníka <span class="pill planned" style="vertical-align:middle;">🇩🇪 nemecky</span></h2>
    <% if (sent) { %><div class="alert alert-info">E-mail bol odoslaný zákazníkovi na <b><%= toEmail %></b>. Stav dopytu je „Odoslaný".</div><% } %>
    <% if (sendError) { %><div class="alert alert-error"><%= sendError %></div><% } %>
    <p class="muted" style="margin-top:0;">
      <% if (toEmail) { %>Príjemca: <b><%= toEmail %></b> · Text môžeš pred odoslaním upraviť.<% } else { %>Zákazník nemá e-mailový kontakt — doplň ho v <% if (customer) { %><a href="/zakaznici/<%= customer.id %>">karte zákazníka</a><% } else { %>karte zákazníka<% } %>.<% } %>
    </p>
    <form method="post" action="/dopyty/<%= inquiry.id %>/send" onsubmit="return confirm('Odoslať e-mail zákazníkovi<%= toEmail ? ' na ' + toEmail : '' %>?')">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label>Predmet</label><input name="subject" value="<%= subject %>"></div>
      <div class="field"><label>Text e-mailu</label><textarea name="body" rows="18" style="font-family:inherit;"><%= body %></textarea></div>
      <div class="actions">
        <% if (smtpReady && toEmail) { %>
          <button class="btn btn-primary"><%- icon('send', 16) %> Odoslať zo servera</button>
        <% } %>
        <a class="btn <%= (smtpReady && toEmail) ? 'btn-ghost' : 'btn-primary' %>" href="<%= mailto %>"><%- icon('send', 16) %> Otvoriť v e-maile</a>
      </div>
    </form>
    <p class="muted" style="font-size:.82rem; margin-top:8px;">
      <% if (smtpReady) { %>„Odoslať zo servera" pošle (aj upravený) text priamo cez firemný SMTP. „Otvoriť v e-maile" otvorí tvojho poštového klienta s pôvodným textom.<% } else { %>„Otvoriť v e-maile" otvorí tvojho poštového klienta s predvyplneným textom. (Priame odosielanie zo servera sa zapne po nastavení SMTP.)<% } %>
    </p>
  </div>
</div>
