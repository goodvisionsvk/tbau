<div class="card">
  <form method="get" action="/reporty" class="form-row" style="align-items:end; margin:0;">
    <div class="field" style="margin-bottom:0;"><label>Stavba</label>
      <select name="project" onchange="this.form.submit()">
        <option value="">Všetky stavby</option>
        <% projects.forEach(function(p){ %>
          <option value="<%= p.id %>" <%= selectedProject===p.id?'selected':'' %>><%= p.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;"><label>Rok</label><input type="number" name="year" value="<%= year %>" style="max-width:110px;"></div>
    <div class="field" style="margin-bottom:0;"><label>Mesiac</label>
      <select name="month">
        <% for (var m=1;m<=12;m++){ %><option value="<%= m %>" <%= month===m?'selected':'' %>><%= m %></option><% } %>
      </select>
    </div>
    <div class="field" style="margin-bottom:0;"><button class="btn btn-ghost">Zobraziť</button></div>
    <div class="field" style="margin-bottom:0;"><a class="btn btn-dark" href="/reporty/export?year=<%= year %>&month=<%= month %>&project=<%= selectedProject || '' %>">⬇ Export pre mzdy (CSV)</a></div>
  </form>
</div>
<p class="muted" style="margin-top:8px;">Export pre mzdy je vždy mesačný<%= selectedProject ? ' (filtrovaný podľa vybranej stavby)' : ' (všetky stavby)' %>.</p>

<div class="section">
  <h2>Odpracované hodiny — <%= monthName %> <%= year %></h2>
  <% if (!employees.length) { %>
    <div class="card muted">Za tento mesiac nie sú žiadne záznamy dochádzky.</div>
  <% } else { %>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Priezvisko a meno</th><th>Os. číslo</th><th style="text-align:right;">Dni</th><th style="text-align:right;">Hodiny spolu</th></tr></thead>
        <tbody>
          <% employees.forEach(function(e){ %>
            <tr>
              <td><b><%= e.last_name %> <%= e.first_name %></b></td>
              <td class="muted"><%= e.employee_number || '—' %></td>
              <td style="text-align:right;"><%= e.days %></td>
              <td style="text-align:right;"><b><%= e.total %></b></td>
            </tr>
          <% }) %>
        </tbody>
        <tfoot><tr><th colspan="3">Spolu</th><th style="text-align:right;"><%= totalHours %> h</th></tr></tfoot>
      </table>
    </div>
  <% } %>
</div>

<% if (byProject && byProject.length) { %>
<div class="section">
  <h2>Podľa stavby</h2>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Stavba</th><th style="text-align:right;">Ľudia</th><th style="text-align:right;">Hodiny</th></tr></thead>
      <tbody>
        <% byProject.forEach(function(p){ %>
          <tr><td><%= p.project_name %></td><td style="text-align:right;"><%= p.people %></td><td style="text-align:right;"><b><%= p.total %></b></td></tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<% } %>
