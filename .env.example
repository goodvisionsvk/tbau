# Skopíruj do .env a doplň hodnoty (.env sa NEcommituje)
NODE_ENV=production
PORT=3000

# Tajný kľúč pre automatický zápis tokenov (worklog API) – rovnaký ako lokálny .worklog-secret
WORKLOG_SECRET=

# Tajný kľúč pre session cookies – vygeneruj napr.:  openssl rand -hex 32
SESSION_SECRET=zmen-ma-na-nahodny-retazec

# Cesta k SQLite databáze
DB_PATH=./data/tbau.db

# Nastav na 1 ak beží za HTTPS reverzným proxy (secure cookies)
TRUST_PROXY=1
SECURE_COOKIES=0

# SMTP (odosielanie e-mailov – dopyty zákazníkom, notifikácie). Ak prázdne, e-maily sa neodosielajú.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TBAU portál <portal@tbau.eu>
